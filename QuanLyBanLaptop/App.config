<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- DataProcesser / DbHelpers đọc khóa "QuanLyBanLaptop". Đổi Server cho khớp máy bạn (vd: localhost\SQLEXPRESS hoặc .\SQLEXPRESS). -->
        <add name="QuanLyBanLaptop" 
             connectionString="Server=.\SQLEXPRESS;Database=QuanLyBanLaptop_V2;Integrated Security=True;TrustServerCertificate=True;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>