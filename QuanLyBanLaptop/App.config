<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Đổi Server cho đúng máy của bạn (ví dụ .\SQLEXPRESS). DbHelper đọc khóa "QuanLyBanLaptopDB". -->
        <add name="QuanLyBanLaptopDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=QuanLyBanLaptop;Integrated Security=True;Connect Timeout=10;" providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>