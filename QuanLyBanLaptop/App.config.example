<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Đổi Server cho khớp máy bạn (vd: .\SQLEXPRESS hoặc (localdb)\MSSQLLocalDB). -->
        <add name="QuanLyBanLaptop" 
             connectionString="Server=.\SQLEXPRESS;Database=QuanLyBanLaptop;Integrated Security=True;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
